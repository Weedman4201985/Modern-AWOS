body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    color: #333;
}

header, footer {
    background: #004080;
    color: white;
    padding: 1em;
    text-align: center;
}

main {
    padding: 2em;
}

#weather-data {
    margin: 0.5em 0;
}

#manual-refresh {
    padding: 8px 16px;
    font-size: 14px;
    cursor: pointer;
}

#report-info {
    background: white;
    padding: 1em;
    border-radius: 8px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1)
}

/*#refresh-label {*/
/*  font-size: 0.85em;*/
/*  color: #333;    */
/*}*/


#refresh-label {
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.6);
    padding: 4px 8px;
    border-radius: 4px 4px 0 0;
}

/* Header layout */
.header-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 10px;
    gap: 6px;
}

.station-id,
.lat-long {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    margin: 0;
}

/* Bottom section layout */
.header-bottom {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 12px;
}

/* Refresh row layout */
.refresh-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 20px;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
}

/* Individual blocks */
.refresh-row > div {
    flex: 1 1 200px;
    min-width: 160px;
    text-align: center;
}

/* Set wrapping order */
.server-report-time { order: 1; }
.awos-report-time { order: 2; }

/* Prevent mid-line wrapping */
.server-report-time span,
.awos-report-time span {
    white-space: nowrap;
}

/* Global paragraph spacing */
p {
    margin: 4px 0;
}

.refresh-wrapper {
  position: fixed;
  bottom: 5px;
  right: 5px;
  display: flex;
  align-items: flex-end;
  gap: 5px;
}

/* Raw XML button styling */
.raw-button {
  padding: 10px 12px;
  font-size: 0.9em;
  background-color: #f0f0f0;
  color: #0077cc;
  border: 1px solid #ccc;
  border-radius: 10px;
  cursor: pointer;
}

/* Countdown and Refresh Now stacked vertically */
.refresh-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  background-color: rgba(255, 255, 255, 0.9);
  padding: 10px;
  border-radius: 8px;
  box-shadow: 0 0 8px rgba(0,0,0,0.2);
}

.refresh-button {
  padding: 6px 12px;
  font-size: 0.9em;
  background-color: #0077cc;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}

.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0; top: 0;
    width: 100%; height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
}

.modal-content {
    background-color: #f9f9f9;
    margin: 5% auto;
    padding: 20px 30px;
    width: 90%;
    max-width: 900px;
    max-height: 80vh;
    overflow-y: auto;
    border-radius: 10px;
    box-shadow: 0 0 20px rgba(0,0,0,0.3);
    font-family: 'Courier New', Courier, monospace;
}

.modal-content h2 {
    margin-top: 0;
    font-size: 1.5rem;
    border-bottom: 1px solid #ccc;
    padding-bottom: 10px;
}

.xml-box {
    background-color: #fff;
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 6px;
    white-space: pre-wrap;
    word-break: break-word;
    font-size: 0.9rem;
    line-height: 1.4;
    color: #333;
}

.close {
    float: right;
    font-size: 28px;
    font-weight: bold;
    color: #666;
    cursor: pointer;
}

.close:hover {
    color: #000;
}


